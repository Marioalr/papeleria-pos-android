<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Sin cámara la app se instala igual (el banco de pruebas no la necesita). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".EscanerApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_escaner"
        android:label="@string/nombre_app"
        android:supportsRtl="true"
        android:theme="@style/Tema.Escaner">

        <!-- En vertical: el escáner, la franja y la guía están pensados para el celular en una mano. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Para compartir los CSV de la sesión de prueba y del banco (cache/exports). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_exportacion" />
        </provider>
    </application>
</manifest>
